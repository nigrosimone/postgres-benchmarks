{
  "name": "postgres-benchmarks",
  "version": "1.0.0",
  "description": "A benchmark focusing on the performance of Postgres client libraries for Node.js, brianc/node-postgres VS porsager/postgres",
  "keywords": [
    "nodejs",
    "javascript",
    "benchmark",
    "postgresql",
    "node-js",
    "pg",
    "postgres",
    "pg-native",
    "node",
    "postgres.js"
  ],
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "bench": "node --expose-gc index.ts",
    "docker-build": "docker-compose build",
    "docker-up": "docker-compose up"
  },
  "author": "Simone Nigro",
  "license": "ISC",
  "dependencies": {
    "pg": "^8.23.0",
    "pg-native": "^3.9.0",
    "postgres": "^3.4.9",
    "tinybench": "^6.1.3"
  },
  "overrides": {
    "pg-types": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "libpq": true
  }
}
